#!/usr/bin/env bash
#
# Backup / restore macOS preference domains.
#
# Backups are written with `defaults export`, which produces a real property
# list. `defaults read` produces the legacy ASCII dump, which `defaults import`
# cannot parse -- do not switch back to it.

set -euo pipefail

BACKUP_DIR="${BACKUP_DIR:-$HOME/Desktop/MacOS_Settings_Backup}"

DOMAINS=(
  "com.apple.AppleMultitouchMouse"
  "com.apple.AppleMultitouchTrackpad"
  "com.apple.HIToolbox"
  "com.apple.LaunchServices"
  "com.apple.Spotlight"
  "com.apple.driver.AppleBluetoothMultitouch.mouse"
  "com.apple.driver.AppleBluetoothMultitouch.trackpad"
  "com.apple.dock"
  "com.apple.finder"
  "com.apple.loginwindow"
  "com.apple.menuextra.clock"
  "com.apple.screencapture"
  "com.apple.screensaver"
  "com.apple.spaces"
  "com.apple.systempreferences"
  "com.apple.systemuiserver"
  "NSGlobalDomain"
)

# Restart whatever service owns the domain, so the change is visible now.
refresh_domain() {
  case "$1" in
  com.apple.dock | com.apple.spaces) killall Dock 2>/dev/null || true ;;
  com.apple.finder) killall Finder 2>/dev/null || true ;;
  com.apple.systemuiserver | com.apple.menuextra.clock) killall SystemUIServer 2>/dev/null || true ;;
  esac
}

backup() {
  local backup_path
  backup_path="$BACKUP_DIR/$(date +%Y%m%d_%H%M%S)"
  mkdir -p "$backup_path"

  local domain
  for domain in "${DOMAINS[@]}"; do
    # An unset domain exports an empty dict, which is useless to restore.
    if ! defaults read "$domain" &>/dev/null; then
      echo "skip    $domain (no settings)"
      continue
    fi
    if defaults export "$domain" "$backup_path/${domain}.plist"; then
      echo "backup  $domain"
    else
      echo "FAILED  $domain" >&2
      rm -f "$backup_path/${domain}.plist"
    fi
  done

  echo
  echo "Backup completed: $backup_path"
}

restore_file() {
  local file="$1"
  if [[ ! -f "$file" ]]; then
    echo "File not found: $file" >&2
    return 1
  fi
  if ! plutil -lint "$file" >/dev/null 2>&1; then
    echo "Not a valid plist (was it made with 'defaults read'?): $file" >&2
    return 1
  fi

  local domain
  domain=$(basename "$file" .plist)
  defaults import "$domain" "$file"
  refresh_domain "$domain"
  echo "restore $domain"
}

restore() {
  local target="$1"
  if [[ -d "$target" ]]; then
    local file
    for file in "$target"/*.plist; do
      [[ -e "$file" ]] || { echo "No .plist files in $target" >&2; return 1; }
      restore_file "$file"
    done
    echo
    echo "Restore completed. Log out and back in for all changes to apply."
    return
  fi
  restore_file "$target"
}

main() {
  case "${1:-}" in
  backup)
    backup
    ;;
  restore)
    if [[ -z "${2:-}" ]]; then
      echo "Please specify a backup file or directory to restore" >&2
      exit 1
    fi
    restore "$2"
    ;;
  *)
    cat <<EOF
Usage: $0 backup
       $0 restore <backup-dir|domain.plist>

Backups are written to \$BACKUP_DIR (default: $BACKUP_DIR).
EOF
    exit 1
    ;;
  esac
}

main "$@"
