#!/usr/bin/env bash

# shellcheck source=./common
source "$(dirname "${BASH_SOURCE[0]}")/common"

setup_osx_gui() {
  defaults write com.apple.finder AppleShowAllFiles -bool true    # show hidden files
  defaults write com.apple.dock persistent-apps -array            # remove icons in Dock
  defaults write com.apple.dock tilesize -int 72                  # smaller icon sizes in Dock
  defaults write com.apple.dock autohide -bool true               # turn Dock auto-hiding on
  defaults write com.apple.dock autohide-delay -float 0           # remove Dock show delay
  defaults write com.apple.dock autohide-time-modifier -float 0   # remove Dock show delay
  defaults write com.apple.dock orientation bottom                # place Dock on the bottom side of screen
  defaults write NSGlobalDomain AppleShowAllExtensions -bool true # show all file extensions

  # These run as the logged-in user; sudo would target root's (nonexistent) session.
  killall Dock 2>/dev/null || true
  killall Finder 2>/dev/null || true
  killall SystemUIServer 2>/dev/null || true
}

install_xcode() {
  if xcode-select -p &>/dev/null; then
    echo "Command Line Tools are already installed."
    return
  fi
  # https://github.com/timsutton/osx-vm-templates/blob/ce8df8a/scripts/xcode-cli-tools.sh
  touch /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
  local prod
  prod=$(softwareupdate -l | grep -o "Command Line Tools for Xcode-.*" | tail -n 1 | tr -d '\n')
  softwareupdate -i "$prod" --verbose
  rm -f /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
}

install_homebrew() {
  if ! command -v brew &>/dev/null; then
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    # Apple Silicon installs to /opt/homebrew, Intel to /usr/local.
    if [[ -x /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    else
      eval "$(/usr/local/bin/brew shellenv)"
    fi
  fi

  # update refreshes the formula definitions; upgrade must come after it.
  brew update
  brew upgrade
}

# brew_install_with_requirement <file> [extra brew args, e.g. --cask]
# Installs one package per call so a single failure does not abort the batch.
brew_install_with_requirement() {
  local file="$1" pkg
  shift
  while read -r pkg; do
    [[ -n "$pkg" && "$pkg" != \#* ]] || continue
    HOMEBREW_NO_AUTO_UPDATE=1 brew install "$@" "$pkg" || echo "FAILED: brew install $* $pkg" >&2
  done <"$file"
}

config_sudo() {
  local dest=/etc/sudoers.d/10-admin-nopasswd

  if sudo test -f "$dest"; then
    echo "passwordless sudo is already configured."
    return
  fi

  # Never edit /etc/sudoers in place. A malformed sudoers file breaks sudo
  # entirely and is only recoverable from recovery mode, so validate the
  # snippet with visudo before installing it.
  local tmp
  tmp="$(mktemp)"
  printf '%%admin ALL = (ALL) NOPASSWD: ALL\n' >"$tmp"

  if ! sudo visudo -cf "$tmp"; then
    echo "config_sudo: generated sudoers snippet failed validation, aborting." >&2
    rm -f "$tmp"
    return 1
  fi

  sudo install -m 0440 -o root -g wheel "$tmp" "$dest"
  rm -f "$tmp"
  echo "installed $dest"
}

config_zsh() {
  # pip refuses to install into the brew-managed Python without this.
  mkdir -p "${HOME}/.config/pip"
  if ! grep -q "break-system-packages = true" "${HOME}/.config/pip/pip.conf" 2>/dev/null; then
    printf '[global]\nbreak-system-packages = true\n' >>"${HOME}/.config/pip/pip.conf"
  fi

  # oh-my-zsh. Update in place rather than wiping it -- $ZSH_CUSTOM lives in
  # this repo, but plugins/ and themes/ under it do not.
  if [[ -d ${HOME}/.oh-my-zsh/.git ]]; then
    git -C "${HOME}/.oh-my-zsh" pull --ff-only || true
  else
    RUNZSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
  fi

  # configs/apps/.zshrc already sources powerlevel10k, so nothing is appended
  # to ~/.zshrc here -- it is a symlink into this repo and would be dirtied.
  brew install powerlevel10k
  brew tap homebrew/command-not-found

  if [[ "$SHELL" != "$(command -v zsh)" ]]; then
    chsh -s "$(command -v zsh)" || true
  fi
}

config_iterm2() {
  defaults write com.googlecode.iterm2 PrefsCustomFolder -string "${DOTFILES_DIR}/configs/apps/iterm2"
  defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
}

install_go() {
  # always source to fix https://github.com/moovweb/gvm/issues/188#issuecomment-372918090
  # shellcheck source=/dev/null
  source "${HOME}/.gvm/scripts/gvm"

  if gvm list | grep -q "go1.23"; then
    echo "go1.23 is already installed."
    return
  fi
  brew install go
  gvm install go1.23
  gvm use go1.23 --default
  brew uninstall go
}

mac_app_store_install_applications() {
  if ! command -v mas &>/dev/null; then
    echo "mas not found, skipping App Store apps."
    return
  fi

  local installed app
  installed="$(mas list)"
  while read -r app; do
    [[ -n "$app" && "$app" != \#* ]] || continue
    if grep -qF "$app" <<<"$installed"; then
      echo "$app is already installed."
      continue
    fi
    mas lucky "$app" || echo "FAILED: $app" >&2
  done <"$1"
  mas upgrade
}

install_session_manager_plugin() {
  if command -v session-manager-plugin &>/dev/null; then
    echo "session-manager-plugin is already installed."
    return
  fi

  local arch tmp
  case "$(uname -m)" in
  arm64) arch=mac_arm64 ;;
  *) arch=mac ;;
  esac

  tmp="$(mktemp -d)"
  curl -fsSL -o "${tmp}/bundle.zip" \
    "https://s3.amazonaws.com/session-manager-downloads/plugin/latest/${arch}/sessionmanager-bundle.zip"
  unzip -q "${tmp}/bundle.zip" -d "$tmp"
  sudo "${tmp}/sessionmanager-bundle/install" \
    -i /usr/local/sessionmanagerplugin \
    -b /usr/local/bin/session-manager-plugin
  rm -rf "$tmp"
}
