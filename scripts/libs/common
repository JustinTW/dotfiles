#!/usr/bin/env bash

# Repo root, so the stack scripts work from any working directory.
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)}"
export DOTFILES_DIR

# Symlink $1 -> $2, preserving anything real that is already at $1.
link_dotfile() {
  local target="$1" source="$2"

  if [[ ! -e "$source" ]]; then
    echo "link_dotfile: source missing, skipping: $source" >&2
    return 0
  fi

  if [[ -L "$target" ]]; then
    # Already pointing at us -- nothing to do. Otherwise drop it; a symlink
    # holds no data worth backing up.
    [[ "$(readlink "$target")" == "$source" ]] && return 0
    rm -f "$target"
  elif [[ -e "$target" ]]; then
    # A real file or directory: never delete, always move aside.
    mv "$target" "$target.pre-$(date +%Y%m%d-%H%M%S)"
  fi

  mkdir -p "$(dirname "$target")"
  ln -sfn "$source" "$target"
}

config_apps() {
  link_dotfile "${HOME}/Library/Application Support/Code/User/settings.json" "${DOTFILES_DIR}/configs/apps/vscode/settings.json"
  link_dotfile "${HOME}/.gitignore_global" "${DOTFILES_DIR}/configs/apps/.gitignore_global"
  link_dotfile "${HOME}/.p10k.zsh" "${DOTFILES_DIR}/configs/apps/.p10k.zsh"
  link_dotfile "${HOME}/.vimrc" "${DOTFILES_DIR}/configs/apps/.vimrc"
  link_dotfile "${HOME}/.zshrc" "${DOTFILES_DIR}/configs/apps/.zshrc"
}

gpg_fingerprint() {
  gpg --list-secret-keys --with-colons "$1" 2>/dev/null | awk -F: '/^fpr:/ {print $10; exit}'
}

config_git() {
  git config --global core.excludesfile "${HOME}/.gitignore_global"
  git config --global user.name "${GIT_USER_NAME}"
  git config --global user.email "${GIT_USER_EMAIL}"
  git config --global --bool pull.rebase true
  # No --add here: it appends a duplicate entry on every re-run.
  git config --global --bool push.autoSetupRemote true

  local uid="${GIT_USER_NAME} <${GIT_USER_EMAIL}>"
  local key
  key=$(gpg_fingerprint "$uid")

  if [[ -z "$key" ]]; then
    # Unattended provisioning, so no passphrase. On a machine you do not fully
    # trust, add one afterwards with: gpg --edit-key <key> passwd
    gpg --batch --passphrase '' --quick-gen-key "$uid" rsa4096 default
    key=$(gpg_fingerprint "$uid")
  fi

  if [[ -z "$key" ]]; then
    echo "config_git: could not resolve a GPG key for $uid, skipping signing setup." >&2
    return 0
  fi

  # Without these the key exists but git never actually uses it.
  git config --global user.signingkey "$key"
  git config --global --bool commit.gpgsign true

  local public_key_file="${HOME}/.gnupg/public-keys/${key}.gpg"
  mkdir -p "$(dirname "$public_key_file")"
  gpg --armor --yes --output "$public_key_file" --export "$key"
  echo "Add this public key to GitHub/GitLab:"
  cat "$public_key_file"
}

install_pyenv() {
  if [[ -x ${HOME}/.pyenv/bin/pyenv ]]; then
    echo "pyenv is already installed."
    (cd "${HOME}/.pyenv" && git pull)
    return
  fi
  curl -fsSL https://pyenv.run | bash
}

install_python() {
  export PYENV_ROOT="${HOME}/.pyenv"
  export PATH="${PYENV_ROOT}/bin:${PATH}"
  eval "$(pyenv init -)"
  eval "$(pyenv virtualenv-init -)"

  local pypy=pypy3.10-7.3.17
  if [[ ! -d ${PYENV_ROOT}/versions/${pypy} ]]; then
    pyenv install "$pypy"
    pyenv global "$pypy"
    pip3 install virtualenvwrapper pygments
    curl -sSL https://install.python-poetry.org | python3 -
  fi

  if [[ ! -d ${PYENV_ROOT}/versions/3.10 ]]; then
    pyenv virtualenv "$pypy" 3.10
  fi

  # The old `brew uninstall --ignore-dependencies openssl gettext readline`
  # workaround for pyenv#2624 lived here. It broke every formula linked against
  # openssl (curl, git, wget, python) and the upstream bug is long fixed.
  if [[ ! -d ${PYENV_ROOT}/versions/3.11 ]]; then
    pyenv install 3.11
    pip3 install virtualenvwrapper pygments
  fi

  pyenv global 3.11
}

install_nvm() {
  if [[ -s ${HOME}/.nvm/nvm.sh ]]; then
    echo "nvm is already installed."
    return
  fi
  curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash
}

install_node() {
  export NVM_DIR="${HOME}/.nvm"
  # shellcheck disable=SC1091
  [ -s "${NVM_DIR}/nvm.sh" ] && \. "${NVM_DIR}/nvm.sh"

  # Node 20 went end-of-life in April 2026.
  nvm install 22
  nvm use 22
  nvm alias default 22
  npm install -g yarn
  # The zsh-nvm plugin used to be cloned here, but it was never listed in
  # plugins=() in .zshrc. The oh-my-zsh `nvm` plugin covers this already.
}

install_gvm() {
  if [[ -s ${HOME}/.gvm/scripts/gvm ]]; then
    echo "gvm is already installed."
    return
  fi
  bash < <(curl -fsSL https://raw.githubusercontent.com/moovweb/gvm/master/binscripts/gvm-installer)
}

install_vscode_ext() {
  if ! command -v code &>/dev/null; then
    echo "code CLI not found, skipping extensions."
    return
  fi

  echo "Installing VS Code extensions..."
  local ext
  while read -r ext; do
    [[ -n "$ext" ]] || continue
    code --install-extension "$ext" --force >/dev/null || echo "FAILED: $ext" >&2
  done <"${DOTFILES_DIR}/requirements/vscode/extensions.txt"
}

# Wire the Amazon ECR Docker Credential Helper into ~/.docker/config.json.
#
# Without this the helper binary is installed but unused, and every registry
# relies on the 12-hour token that `aws ecr get-login-password | docker login`
# writes into .auths. credHelpers does not support wildcards
# (https://github.com/docker/cli/issues/2928), so each registry is listed
# explicitly. credsStore is deliberately not used: it would route *every*
# registry, Docker Hub included, through ecr-login.
config_ecr_credential_helper() {
  if ! command -v docker-credential-ecr-login &>/dev/null; then
    echo "docker-credential-ecr-login not found, skipping ECR helper setup."
    return
  fi
  if ! command -v jq &>/dev/null; then
    echo "jq not found, skipping ECR helper setup." >&2
    return
  fi

  local config="${HOME}/.docker/config.json"
  mkdir -p "$(dirname "$config")"
  [[ -s "$config" ]] || echo '{}' >"$config"

  # Registries to route through the helper:
  #   - public.ecr.aws
  #   - whatever ECR_REGISTRIES lists in .env (space separated)
  #   - every ECR registry this machine has already logged in to, so an
  #     existing config migrates off its stored tokens on its own
  local registries
  registries=$(
    {
      echo "public.ecr.aws"
      tr ' ' '\n' <<<"${ECR_REGISTRIES:-}"
      jq -r '((.auths // {}) + (.credHelpers // {})) | keys[]' "$config"
    } | grep -E '^([0-9]+\.dkr\.ecr\.[a-z0-9-]+\.amazonaws\.com|public\.ecr\.aws)$' | sort -u
  )

  local regs_json tmp
  regs_json=$(jq -R -s 'split("\n") | map(select(length > 0))' <<<"$registries")
  tmp=$(mktemp)

  # Point each registry at ecr-login, and drop the stored ECR tokens it
  # replaces. Non-ECR auths are left untouched.
  jq --argjson regs "$regs_json" '
    .credHelpers = ((.credHelpers // {}) + ($regs | map({key: ., value: "ecr-login"}) | from_entries))
    | .auths = ((.auths // {}) | with_entries(select(.key as $k | ($regs | index($k)) | not)))
  ' "$config" >"$tmp"

  if ! jq -e . "$tmp" >/dev/null 2>&1; then
    echo "config_ecr_credential_helper: produced invalid JSON, leaving config alone." >&2
    rm -f "$tmp"
    return 1
  fi

  cp "$config" "${config}.pre-$(date +%Y%m%d-%H%M%S)"
  mv "$tmp" "$config"
  chmod 600 "$config"
  echo "ECR credential helper wired up for:"
  local reg
  while read -r reg; do echo "  $reg"; done <<<"$registries"
}

install_kubectl() {
  if command -v kubectl &>/dev/null; then
    echo "kubectl is already installed."
  else
    local os arch ver tmp
    os="$(uname | tr '[:upper:]' '[:lower:]')"
    arch="$(uname -m | sed -e 's/x86_64/amd64/' -e 's/aarch64/arm64/')"
    ver="$(curl -fsSL https://dl.k8s.io/release/stable.txt)"
    tmp="$(mktemp -d)"

    curl -fsSL -o "${tmp}/kubectl" "https://dl.k8s.io/release/${ver}/bin/${os}/${arch}/kubectl"
    curl -fsSL -o "${tmp}/kubectl.sha256" "https://dl.k8s.io/release/${ver}/bin/${os}/${arch}/kubectl.sha256"
    (cd "$tmp" && echo "$(cat kubectl.sha256)  kubectl" | shasum -a 256 -c -)

    sudo mkdir -p /usr/local/bin
    sudo install -m 0755 "${tmp}/kubectl" /usr/local/bin/kubectl
    rm -rf "$tmp"
  fi

  export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
  if ! command -v kubectl-krew &>/dev/null; then
    (
      cd "$(mktemp -d)" &&
        OS="$(uname | tr '[:upper:]' '[:lower:]')" &&
        ARCH="$(uname -m | sed -e 's/x86_64/amd64/' -e 's/aarch64/arm64/')" &&
        KREW="krew-${OS}_${ARCH}" &&
        curl -fsSLO "https://github.com/kubernetes-sigs/krew/releases/latest/download/${KREW}.tar.gz" &&
        tar zxf "${KREW}.tar.gz" &&
        ./"${KREW}" install krew
    )
  fi
  kubectl krew install ctx ns
}
