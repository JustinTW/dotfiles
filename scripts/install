#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
export DOTFILES_DIR
cd "$DOTFILES_DIR"

usage() {
  cat <<EOF

Usage: ./scripts/install <stack>

Available stacks:

  base, b     Setup base environment (Homebrew, shell, dotfiles, App Store apps)
  web, w      Additional packages for web development
  moxa        Additional packages for Moxa staff
  debug, db   Re-apply sudo and dotfile symlinks only

Environment:

  DEBUG=1     Trace every command

EOF
  exit 1
}

load_dotenv() {
  if [[ ! -f .env ]]; then
    echo "Missing .env. Create it first:" >&2
    echo "  cp configs/dotenv/example.env .env" >&2
    exit 1
  fi

  set -a
  # shellcheck source=/dev/null
  source .env
  set +a

  local missing=()
  [[ -n "${GIT_USER_NAME:-}" ]] || missing+=(GIT_USER_NAME)
  [[ -n "${GIT_USER_EMAIL:-}" ]] || missing+=(GIT_USER_EMAIL)
  if ((${#missing[@]})); then
    echo "Missing required variables in .env: ${missing[*]}" >&2
    exit 1
  fi
}

platform() {
  case "$(uname)" in
  Darwin) echo osx ;;
  Linux)
    if command -v apt &>/dev/null; then
      echo debian
    elif command -v apk &>/dev/null; then
      echo alpine
    elif command -v yum &>/dev/null; then
      echo centos
    else
      echo unsupported
    fi
    ;;
  *) echo unsupported ;;
  esac
}

install() {
  local script
  script="${DOTFILES_DIR}/scripts/stack/$1/$2/$(platform)"
  if [[ ! -x "$script" ]]; then
    echo "No installer for this platform: ${script}" >&2
    exit 1
  fi
  load_dotenv
  "$script"
}

main() {
  if [[ "$(platform)" == unsupported ]]; then
    echo "this os is not supported" >&2
    exit 1
  fi

  case "${1:-}" in
  base | b) install common base ;;
  web | w) install developer web ;;
  moxa) install enterprise moxa ;;
  debug | db) install misc debug ;;
  *) usage ;;
  esac
}

main "$@"
