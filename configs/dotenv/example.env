GIT_USER_NAME="Alice CT Chen"
GIT_USER_EMAIL="alice@example.com"

# Optional. ECR registries to route through the Amazon ECR Docker Credential
# Helper, space separated. Registries this machine has already logged in to are
# picked up automatically, so this is mainly for a fresh install.
# credHelpers has no wildcard support (docker/cli#2928), hence the explicit list.
ECR_REGISTRIES="123456789012.dkr.ecr.us-west-2.amazonaws.com 123456789012.dkr.ecr.ap-northeast-1.amazonaws.com"
